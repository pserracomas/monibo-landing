---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../layouts/Base.astro';
import StoreButton from '../components/StoreButton.astro';
import icon from '../assets/icon.png';
import { PRICES } from '../consts';
import { euros, path, ui, type Lang } from '../i18n/ui';

interface Props {
	lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];

const allShots = import.meta.glob<{ default: ImageMetadata }>('../assets/shots/*/*.png', { eager: true });
const shots = Object.entries(allShots)
	.filter(([file]) => file.includes(`/shots/${lang}/`))
	.sort(([a], [b]) => a.localeCompare(b))
	.map(([, mod], i) => ({ src: mod.default, alt: t.shots[i] ?? '' }));

const plans = [
	{ name: t.pro.monthly, price: euros(PRICES.monthly, lang), unit: t.pro.perMonth, note: t.pro.trial(PRICES.trialDays) },
	{ name: t.pro.yearly, price: euros(PRICES.yearly, lang), unit: t.pro.perYear, note: t.pro.trial(PRICES.trialDays), featured: true },
	{ name: t.pro.lifetime, price: euros(PRICES.lifetime, lang), unit: '', note: t.pro.once },
];
const coins = ['var(--yellow)', 'var(--orange)', 'var(--mint)'];
---

<Base lang={lang} slug="">
	<section class="hero">
		<div class="wrap hero-grid">
			<div class="hero-copy">
				<p class="kicker">
					<Image src={icon} alt="" width={44} height={44} densities={[1, 2]} loading="eager" class="hero-icon" />
					{t.hero.kicker}
				</p>
				<h1 class="display">{t.hero.title}</h1>
				<p class="lead">{t.hero.lead}</p>
				<StoreButton lang={lang} />
				<p class="note">{t.hero.note}</p>
			</div>
			<div class="hero-shot">
				{shots[0] && <Image src={shots[0].src} alt={shots[0].alt} width={420} densities={[1, 2]} loading="eager" class="shot" />}
			</div>
		</div>
	</section>

	<section class="gallery" aria-label={t.nav.features}>
		<div class="gallery-track">
			{
				shots.slice(1).map((s) => (
					<figure>
						<Image src={s.src} alt={s.alt} width={300} densities={[1, 2]} class="shot" />
					</figure>
				))
			}
		</div>
	</section>

	<section id="features" class="section">
		<div class="wrap">
			<h2 class="display section-title">{t.featuresTitle}</h2>
			<div class="features">
				{
					t.features.map((f, i) => (
						<article class="card feature">
							<span class="coin" style={`--coin:${coins[i % coins.length]}`} aria-hidden="true" />
							<h3>{f.title}</h3>
							<ul>
								{f.items.map((item) => (
									<li>{item}</li>
								))}
							</ul>
						</article>
					))
				}
			</div>
		</div>
	</section>

	<section class="section privacy-band">
		<div class="wrap privacy-grid">
			<div>
				<h2 class="display">{t.privacy.title}</h2>
				<p class="lead">{t.privacy.lead}</p>
				<a class="text-link" href={path(lang, 'privacy')}>{t.privacy.link} →</a>
			</div>
			<ul class="checks">
				{t.privacy.points.map((p) => <li>{p}</li>)}
			</ul>
		</div>
	</section>

	<section id="pro" class="section">
		<div class="wrap">
			<h2 class="display section-title">{t.pro.title}</h2>
			<p class="lead center">{t.pro.lead}</p>
			<div class="pro-grid">
				<article class="card tier">
					<h3>{t.pro.free}</h3>
					<p class="price">{euros(0, lang)}</p>
					<ul class="checks small">{t.pro.freeItems.map((i) => <li>{i}</li>)}</ul>
				</article>
				<article class="card tier tier-pro">
					<h3>Pro</h3>
					<ul class="checks small">{t.pro.items.map((i) => <li>{i}</li>)}</ul>
				</article>
			</div>
			<div class="plans">
				{
					plans.map((p) => (
						<div class:list={['card', 'plan', { featured: p.featured }]}>
							<p class="plan-name">{p.name}</p>
							<p class="price">
								{p.price} <span>{p.unit}</span>
							</p>
							<p class="muted">{p.note}</p>
						</div>
					))
				}
			</div>
			<p class="fine">{t.pro.fine}</p>
			<div class="center"><StoreButton lang={lang} /></div>
		</div>
	</section>
</Base>
